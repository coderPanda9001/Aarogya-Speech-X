# AarogyaSpeech AI - Environment Configuration Example

# Database Connection (PostgreSQL for Docker, SQLite for local dev)
# For Docker: postgresql://aarogya:aarogyapass@db:5432/aarogyaspeech_db
# For Local SQLite: sqlite:///backend/aarogyaspeech.db
DATABASE_URL=postgresql://aarogya:aarogyapass@db:5432/aarogyaspeech_db

# Security & JWT Configuration
JWT_SECRET=aarogya_speech_jwt_secret_key_2026_super_secret_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Server Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
